{
  "name": "nextcrud",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "dotenv -e .env.local -- npx prisma generate",
    "db:migrate": "dotenv -e .env.local -- npx prisma migrate dev --name",
    "db:push": "dotenv -e .env.local -- npx prisma db push",
    "db:reset": "dotenv -e .env.local -- npx prisma migrate reset",
    "db:deploy": "dotenv -e .env.local -- npx prisma migrate deploy",
    "db:seed": "dotenv -e .env.local -- npx prisma db seed",
    "db:studio": "dotenv -e .env.local -- npx prisma studio",
    "test": "jest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@embedpdf/core": "^2.15.0",
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/plugin-annotation": "^2.15.0",
    "@embedpdf/plugin-document-manager": "^2.15.0",
    "@embedpdf/plugin-history": "^2.15.0",
    "@embedpdf/plugin-interaction-manager": "^2.15.0",
    "@embedpdf/plugin-render": "^2.15.0",
    "@embedpdf/plugin-scroll": "^2.15.0",
    "@embedpdf/plugin-selection": "^2.15.0",
    "@embedpdf/plugin-viewport": "^2.15.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fullcalendar/react": "^7.1.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "7.9.0",
    "@prisma/client": "7.9.0",
    "@vercel/blob": "^2.3.3",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "nodemailer": "^7.0.5",
    "postcss": "^8.5.13",
    "prisma": "7.9.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sonner": "^2.0.7",
    "temporal-polyfill": "^1.0.5",
    "tsx": "^4.21.0",
    "ws": "^8.21.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.4",
    "jest": "^30.4.2",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.12",
    "typescript": "^6"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
