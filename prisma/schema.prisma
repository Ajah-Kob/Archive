// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── User ─────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  FACULTY
  STUDENT
  GUEST
}

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  image                String?
  role                 Role                  @default(GUEST)
  activatedAt          DateTime?
  createdAt            DateTime              @default(now())
  loggedInAt           DateTime?             @default(now())
  deletedAt            DateTime?
  password             String?
  updatedAt            DateTime?             @updatedAt
  faculty              Faculty?
  student              Student?
  templates            Template[]
  capstoneArchives     CapstoneArchive[]
  milestoneSubmissions MilestoneSubmission[]
  submissionAnnotations SubmissionAnnotation[]
  invitationsSent              Invitation[]          @relation("InvitationSender")
  topicReviews                 Topic[]               @relation("TopicReviewer")
  milestoneSubmissionsReviewed MilestoneSubmission[] @relation("MilestoneSubmissionReviewer")
  defenseSchedules             DefenseSchedule[]     @relation("DefenseCreatedBy")
  defensePanelists             DefensePanelist[]
  defenseResubmissions         DefenseResubmission[] @relation("DefenseResubmissionSubmitter")
  defenseResubmissionReviews   DefenseResubmissionReview[]
  defenseSubmissions            DefenseSubmission[]          @relation("DefenseSubmissionSubmitter")
  defenseSubmissionReviews      DefenseSubmissionReview[]

  @@index([email, deletedAt])
}

model ResetPasswordToken {
  id         Int      @id(map: "idx_30320_primary") @default(autoincrement())
  email      String   @db.VarChar(191)
  token      String   @unique(map: "idx_30320_resetpasswordtoken_token_key") @db.VarChar(191)
  expires    DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([email, token], map: "idx_30320_resetpasswordtoken_email_token_key")
}

// ───────────────────────────── Faculty ─────────────────────────────

model Faculty {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  user           User         @relation(fields: [userId], references: [id])
  isProgramChair Boolean      @default(false)
  coordinator    Coordinator?
  adviser        Adviser?
  invitations    Invitation[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([deletedAt])
}

model Coordinator {
  id        Int       @id @default(autoincrement())
  facultyId Int       @unique
  faculty   Faculty   @relation(fields: [facultyId], references: [id])
  section   Section[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

model Adviser {
  id        Int        @id @default(autoincrement())
  facultyId Int        @unique
  faculty   Faculty    @relation(fields: [facultyId], references: [id])
  capstones Capstone[]
  groups    Group[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
}

// ───────────────────────────── joinCode ─────────────────────────────

enum JoinType {
  STUDENT
  FACULTY
}

model JoinCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  type      JoinType
  section   Section?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([deletedAt])
}

// ───────────────────────────── Invitation ─────────────────────────────

enum InvitationRole {
  COORDINATOR
  ADVISER
  PANELIST
  GROUP
  ADVISER_ASSIGNMENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  REJECTED
}

model Invitation {
  id          Int              @id @default(autoincrement())
  facultyId   Int?
  faculty     Faculty?         @relation(fields: [facultyId], references: [id])
  studentId   Int?
  student     Student?         @relation(fields: [studentId], references: [id])
  groupId     Int?
  group       Group?           @relation(fields: [groupId], references: [id])
  role        InvitationRole
  invitedById Int
  invitedBy   User             @relation("InvitationSender", fields: [invitedById], references: [id])
  status      InvitationStatus @default(PENDING)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?

  @@index([facultyId])
  @@index([studentId])
  @@index([groupId])
  @@index([invitedById])
  @@index([deletedAt])
}

// ───────────────────────────── Section & Student & Group ─────────────────────────────

model Section {
  id            Int         @id @default(autoincrement())
  joinCodeId    Int?        @unique
  joinCode      JoinCode?   @relation(fields: [joinCodeId], references: [id], onDelete: SetNull)
  coordinatorId Int
  coordinator   Coordinator @relation(fields: [coordinatorId], references: [id])
  section       String
  headerColor   String?
  students      Student[]
  groups        Group[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  capstone2OpenedAt DateTime?
  milestoneAvailability MilestoneAvailability[]

  @@unique([coordinatorId, section])
  @@index([deletedAt])
}

enum MilestoneKey {
  TOPIC_SUBMISSION
  TOPIC_SELECTION
  CHAPTER_1
  CHAPTER_2
  CHAPTER_3
  PROPOSAL_DEFENSE
  CHAPTER_4
  CHAPTER_5
  FINAL_DEFENSE
  ARCHIVING
}

// Section-level availability of each milestone. A row with a set `openedAt`
// means the milestone is open to all groups in the section; `openedAt: null`
// means it is locked. Missing rows fall back to defaults (see
// buildMilestoneAvailability in lib/actions/sections.ts).
model MilestoneAvailability {
  id        Int         @id @default(autoincrement())
  sectionId Int
  section   Section     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  key       MilestoneKey
  openedAt  DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sectionId, key])
  @@index([sectionId])
}

model Student {
  id          Int          @id @default(autoincrement())
  userId      Int          @unique
  user        User         @relation(fields: [userId], references: [id])
  sectionId   Int
  section     Section      @relation(fields: [sectionId], references: [id])
  groupId     Int?
  group       Group?       @relation(fields: [groupId], references: [id])
  ledGroup    Group?       @relation("GroupLeader")
  invitations Invitation[]
  topics      Topic[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
}

model Group {
  id              Int              @id @default(autoincrement())
  groupName       String
  sectionId       Int
  section         Section          @relation(fields: [sectionId], references: [id])
  leaderStudentId Int?             @unique
  leaderStudent   Student?         @relation("GroupLeader", fields: [leaderStudentId], references: [id])
  adviserId       Int?
  adviser         Adviser?         @relation(fields: [adviserId], references: [id])
  students        Student[]
  topics          Topic[]
  capstone        Capstone?
  milestones      Milestone[]
  capstoneArchive CapstoneArchive?
  invitations     Invitation[]
  defenseSchedules DefenseSchedule[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  @@index([sectionId])
  @@index([deletedAt])
}

// ───────────────────────────── Topic & Capstone ─────────────────────────────

enum TopicStatus {
  PENDING
  APPROVED
  NEED_REVISION
}

model Topic {
  id            Int         @id @default(autoincrement())
  groupId       Int
  group         Group       @relation(fields: [groupId], references: [id])
  topicGroupKey String?
  title         String
  background    String
  uploadedById  Int?
  uploadedBy    Student?    @relation(fields: [uploadedById], references: [id])
  status        TopicStatus @default(PENDING)
  reviewNote   String?
  reviewedById Int?
  reviewedBy   User?       @relation("TopicReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  selectedAt   DateTime?
  capstone     Capstone?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  @@index([groupId])
  @@index([uploadedById])
  @@index([status])
  @@index([deletedAt])
}

enum CapstonePhase {
  CAPSTONE_1
  CAPSTONE_2
}

model Capstone {
  id         Int         @id @default(autoincrement())
  groupId    Int         @unique
  group      Group       @relation(fields: [groupId], references: [id])
  topicId    Int         @unique
  topic      Topic       @relation(fields: [topicId], references: [id])
  adviserId  Int?
  adviser    Adviser?    @relation(fields: [adviserId], references: [id])
  milestones Milestone[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  @@index([topicId])
  @@index([adviserId])
  @@index([deletedAt])
}

// ───────────────────────────── Milestone & Submission ─────────────────────────────

enum Chapter {
  CHAPTER_1
  CHAPTER_2
  CHAPTER_3
  CHAPTER_4
  CHAPTER_5
}

model Milestone {
  id          Int                   @id @default(autoincrement())
  groupId     Int
  group       Group                 @relation(fields: [groupId], references: [id])
  phase       CapstonePhase
  chapter     Chapter
  capstoneId  Int
  capstone    Capstone              @relation(fields: [capstoneId], references: [id])
  submissions MilestoneSubmission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  @@unique([groupId, chapter])
  @@index([groupId])
  @@index([capstoneId])
  @@index([deletedAt])
}

enum SubmissionStatus {
  PENDING
  NEED_REVISION
  APPROVED
}

enum AnnotationStatus {
  DRAFT      // auto-saved, adviser-only
  COMMITTED  // visible to the group once verdict is submitted
}

model MilestoneSubmission {
  id           Int              @id @default(autoincrement())
  milestoneId  Int
  milestone    Milestone        @relation(fields: [milestoneId], references: [id])
  submittedBy  Int
  user         User             @relation(fields: [submittedBy], references: [id])
  fileName     String
  blobUrl      String
  mimeType     String
  size         Int
  status       SubmissionStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewNote   String?
  reviewedById Int?
  reviewedBy   User?            @relation("MilestoneSubmissionReviewer", fields: [reviewedById], references: [id])
  annotations  SubmissionAnnotation[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  @@index([milestoneId])
  @@index([submittedBy])
  @@index([deletedAt])
}

// Adviser/panelist in-PDF annotations on a submission. One row per
// (submission, author); `data` holds the serialized AnnotationTransferItem[]
// JSON export (stamp ArrayBuffers base64-encoded). DRAFT rows are private to
// the author; COMMITTED rows are visible to the group once a verdict is
// submitted.
model SubmissionAnnotation {
  id           Int                @id @default(autoincrement())
  submissionId Int
  submission   MilestoneSubmission @relation(fields: [submissionId], references: [id])
  authorId     Int
  author       User               @relation(fields: [authorId], references: [id])
  data         Json
  status       AnnotationStatus   @default(DRAFT)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  @@unique([submissionId, authorId])
  @@index([deletedAt])
}

// ───────────────────────────── Repository ─────────────────────────────

model CapstoneArchive {
  id            Int       @id @default(autoincrement())
  groupId       Int       @unique
  group         Group     @relation(fields: [groupId], references: [id])
  title         String
  abstract      String?
  datePublished DateTime
  fileName      String
  blobUrl       String
  mimeType      String
  size          Int
  uploadedById  Int
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([deletedAt])
}

// ───────────────────────────── Template ─────────────────────────────
model Template {
  id           Int       @id @default(autoincrement())
  name         String
  fileName     String
  blobUrl      String
  mimeType     String
  size         Int
  uploadedById Int
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([deletedAt])
  @@index([uploadedById])
}

// ───────────────────────────── Defense Scheduling ─────────────────────────────

enum DefenseType {
  PROPOSAL
  FINAL
}

enum DefenseVerdict {
  PENDING
  APPROVED
  MINOR_REVISION
  MAJOR_REVISION
  REJECTED
}

enum PanelistRole {
  CHAIR
  PANEL_MEMBER
}

model DefenseSchedule {
  id         Int              @id @default(autoincrement())
  groupId    Int
  group      Group            @relation(fields: [groupId], references: [id])
  type       DefenseType
  date       DateTime
  startTime  String
  endTime    String
  venue      String
  verdict    DefenseVerdict   @default(PENDING)
  createdBy  Int
  createdByUser User          @relation("DefenseCreatedBy", fields: [createdBy], references: [id])
  panelists  DefensePanelist[]
  resubmissions DefenseResubmission[]
  submissions DefenseSubmission[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  deletedAt  DateTime?

  @@index([deletedAt])
  @@index([groupId])
}

model DefensePanelist {
  id                Int             @id @default(autoincrement())
  defenseScheduleId Int
  defenseSchedule   DefenseSchedule @relation(fields: [defenseScheduleId], references: [id])
  userId            Int
  user              User            @relation(fields: [userId], references: [id])
  role              PanelistRole
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  @@index([defenseScheduleId])
  @@index([deletedAt])
}

// A revised manuscript submitted by a group after a defense resulted in a
// revision verdict (MINOR_REVISION / MAJOR_REVISION). One row per resubmission;
// per-panelist review state lives in DefenseResubmissionReview so each panelist
// only sees resubmissions they still need to evaluate (their personal queue).
model DefenseResubmission {
  id          Int                       @id @default(autoincrement())
  scheduleId  Int
  schedule    DefenseSchedule           @relation(fields: [scheduleId], references: [id])
  submittedBy Int
  user        User                      @relation("DefenseResubmissionSubmitter", fields: [submittedBy], references: [id])
  fileName    String
  blobUrl     String
  mimeType    String
  size        Int
  reviews     DefenseResubmissionReview[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  deletedAt   DateTime?

  @@index([scheduleId])
  @@index([deletedAt])
}

// Per-panelist review state for a resubmission. A panelist's Resubmissions tab
// lists the PENDING reviews — i.e. resubmissions they still need to evaluate.
model DefenseResubmissionReview {
  id             Int                       @id @default(autoincrement())
  resubmissionId Int
  resubmission   DefenseResubmission       @relation(fields: [resubmissionId], references: [id])
  panelistId     Int
  panelist       User                      @relation(fields: [panelistId], references: [id])
  status         DefenseResubmissionStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?

  @@unique([resubmissionId, panelistId])
  @@index([deletedAt])
}

enum DefenseResubmissionStatus {
  PENDING
  APPROVED
}

// ───────────────────────────── Defense Submission (unified) ─────────────────────────────

enum DefenseReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// A document submitted for a defense. The initial manuscript (isInitial: true,
// version: 1) and any revised resubmissions (isInitial: false, version: 2+)
// are all stored here. Status is DERIVED, not stored: the initial submission's
// status comes from DefenseSchedule.verdict; a resubmission's status is
// computed from its DefenseSubmissionReview rows (all APPROVED → Approved,
// any PENDING → In Review, any REJECTED → Rejected).
model DefenseSubmission {
  id                Int                       @id @default(autoincrement())
  scheduleId        Int
  schedule          DefenseSchedule           @relation(fields: [scheduleId], references: [id])
  submittedBy       Int
  user              User                      @relation("DefenseSubmissionSubmitter", fields: [submittedBy], references: [id])
  isInitial         Boolean                   @default(false)
  version           Int                       @default(1)
  fileName          String
  blobUrl           String
  mimeType          String
  size              Int
  reviews           DefenseSubmissionReview[]
  annotations       DefenseSubmissionAnnotation[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  @@index([scheduleId])
  @@index([deletedAt])
}

// Per-panelist review state for a defense submission. A panelist's queue lists
// the PENDING reviews — i.e. submissions they still need to evaluate.
model DefenseSubmissionReview {
  id             Int                @id @default(autoincrement())
  submissionId   Int
  submission     DefenseSubmission  @relation(fields: [submissionId], references: [id])
  panelistId     Int
  panelist       User               @relation(fields: [panelistId], references: [id])
  status         DefenseReviewStatus @default(PENDING)
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  @@unique([submissionId, panelistId])
  @@index([deletedAt])
}

// An annotation/comment attached to a defense submission by a panelist.
// Named DefenseSubmissionAnnotation to avoid collision with the existing
// SubmissionAnnotation model used for milestone PDF annotations.
model DefenseSubmissionAnnotation {
  id             Int              @id @default(autoincrement())
  submissionId   Int
  submission     DefenseSubmission @relation(fields: [submissionId], references: [id])
  content        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@index([submissionId])
  @@index([deletedAt])
}
