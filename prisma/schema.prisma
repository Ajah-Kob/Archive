// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ResetPasswordToken {
  id                          BigInt                  @id(map: "idx_30320_primary") @default(autoincrement())
  email                       String                  @db.VarChar(191)
  token                       String                  @unique(map: "idx_30320_resetpasswordtoken_token_key") @db.VarChar(191)
  expires                     DateTime                @db.Timestamptz(6)
  created_at                  DateTime                @default(now()) @db.Timestamptz(6)

  @@unique([email, token], map: "idx_30320_resetpasswordtoken_email_token_key")

}

model User {
  id                          Int                      @id @default(autoincrement())
  name                        String
  email                       String                   @unique
  image                       String?
  role                        Role                     @default(USER)
  activatedAt                 DateTime?
  createdAt                   DateTime                 @default(now())
  loggedInAt                  DateTime?                @default(now())
  deletedAt                   DateTime?
  password                    String?
  updatedAt                   DateTime?                @updatedAt
  faculty                     Faculty?
  student                     Student?
  submissions                 MilestoneSubmission[]
  media                       Media[]
    
  @@index([email, deletedAt])
}


model Faculty {
  id                          Int                     @id @default(autoincrement())
  userId                      Int                     @unique
  user                        User                    @relation(fields: [userId], references: [id])
  coordinator                 Coordinator?
  adviser                     Adviser?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([deletedAt])
}

model Coordinator {
  id                          Int                     @id @default(autoincrement())
  facultyId                   Int                     @unique
  faculty                     Faculty                 @relation(fields: [facultyId], references: [id])
  sections                    Section[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([deletedAt])
}

model Adviser {
  id                          Int                     @id @default(autoincrement())
  facultyId                   Int                     @unique
  faculty                     Faculty                 @relation(fields: [facultyId], references: [id])
  capstones                   Capstone[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([deletedAt])
}

model InvitationCode {
  id                          Int                     @id @default(autoincrement())
  code                        String                  @unique
  type                        InvitationType
  section                     Section?                
  expiresAt                   DateTime
  createdAt                   DateTime                @default(now())
  deletedAt                   DateTime?

  @@index([deletedAt])
}

model Section {
  id                          Int                     @id @default(autoincrement())
  invitationCodeId            Int?                    @unique
  invitationCode              InvitationCode?         @relation(fields: [invitationCodeId], references: [id], onDelete: SetNull)
  coordinatorId               Int
  coordinator                 Coordinator             @relation(fields: [coordinatorId], references: [id])
  section                     String
  yearLevel                   String
  students                    Student[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([deletedAt])
}

model Student {
  id                          Int                     @id @default(autoincrement())
  userId                      Int                     @unique
  user                        User                    @relation(fields: [userId], references: [id])
  sectionId                   Int
  section                     Section                 @relation(fields: [sectionId], references: [id])
  groupId                     Int?
  group                       Group?                  @relation(fields: [groupId], references: [id])
  topics                      Topic[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([deletedAt])
}

model Group {
  id                         Int                      @id @default(autoincrement())
  groupName                  String
  students                   Student[]
  topics                     Topic[]
  capstone                   Capstone?
  milestones                 Milestone[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  deletedAt                  DateTime?

  @@index([deletedAt])
}

enum TopicStatus {
  PENDING
  APPROVED
  REJECTED
}

model Topic {
  id                          Int                     @id @default(autoincrement())
  groupId                     Int
  group                       Group                   @relation(fields: [groupId], references: [id])
  title                       String
  background                  String
  uploadedById                Int?
  uploadedBy                  Student?                @relation(fields: [uploadedById], references: [id])
  status                      TopicStatus             @default(PENDING)
  capstone                    Capstone?
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([groupId])
  @@index([uploadedById])
  @@index([status])
  @@index([deletedAt])
}

model Capstone {
  id                          Int                     @id @default(autoincrement())
  groupId                     Int                     @unique
  group                       Group                   @relation(fields: [groupId], references: [id])
  topicId                     Int                     @unique
  topic                       Topic                   @relation(fields: [topicId], references: [id])
  adviserId                   Int?
  adviser                     Adviser?                @relation(fields: [adviserId], references: [id])
  milestones                  Milestone[]
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([topicId])
  @@index([adviserId])
  @@index([deletedAt])
}

model Milestone {
  id                          Int                     @id @default(autoincrement())
  groupId                     Int
  group                       Group                   @relation(fields: [groupId], references: [id])
  phase                       String
  chapter                     String
  capstoneId                  Int
  capstone                    Capstone                @relation(fields: [capstoneId], references: [id])
  submissions                 MilestoneSubmission[]

  @@index([groupId])
  @@index([capstoneId])
}

enum SubmissionStatus{
  PENDING
  NEED_REVISION
  APPROVED
}

model MilestoneSubmission {
  id                          Int                     @id @default(autoincrement())
  milestoneId                 Int
  milestone                   Milestone               @relation(fields: [milestoneId], references: [id])
  submittedBy                 Int
  user                        User                    @relation(fields: [submittedBy], references: [id])
  mediaId                     Int
  media                       Media                   @relation(fields: [mediaId], references: [id])
  status                      SubmissionStatus        @default(PENDING)
  createdAt                   DateTime                @default(now())
  updatedAt                   DateTime                @updatedAt
  deletedAt                   DateTime?

  @@index([milestoneId])
  @@index([submittedBy])
  @@index([mediaId])
  @@index([deletedAt])
}

model Media {
  id                          Int                     @id @default(autoincrement())
  fileName                    String
  blobUrl                     String
  mimeType                    String
  size                        Int
  uploadedById                Int
  uploadedBy                  User                    @relation(fields: [uploadedById], references: [id])
  submissions                 MilestoneSubmission[]
  createdAt                   DateTime                @default(now())
  deletedAt                   DateTime?

  @@index([deletedAt])
}

enum InvitationType {
  STUDENT
  FACULTY
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}


enum CapstonePhase {
  CAPSTONE_1
  CAPSTONE_2
}

enum Chapter {
  CHAPTER_1
  CHAPTER_2
  CHAPTER_3
  CHAPTER_4
  CHAPTER_5
}